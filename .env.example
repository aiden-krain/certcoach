# Database
DATABASE_URL=postgresql://user:password@localhost:5432/certcoach
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/certcoach_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# External Services
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
POSTMARK_API_TOKEN=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Storage
BLOB_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_NAME=certcoach-assets

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway
API_GATEWAY_PORT=8000
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_WORKERS=1

# Service Ports
PLANNER_SERVICE_PORT=8001
PRACTICE_ENGINE_SERVICE_PORT=8002
ITEM_FACTORY_SERVICE_PORT=8003
MASTERY_SRS_SERVICE_PORT=8004
EXPLAIN_RAG_SERVICE_PORT=8005
TELEMETRY_SERVICE_PORT=8006

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8000
